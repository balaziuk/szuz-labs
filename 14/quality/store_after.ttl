    fin:belongsToAccount fin:Acc_UA123456789 ;
    fin:belongsToCategory fin:Cat_Utilities ;
    fin:hasCounterparty fin:Cp_Utility ;
    fin:operationDate "2026-10-03T00:00:00"^^xsd:dateTime ;
    fin:operationId "00128"^^xsd:string ;
    dcterms:date "2026-10-03T00:00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom "Src_BankExport2026" .

