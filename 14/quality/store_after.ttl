    fin:amount 15000.0 ;
    fin:belongsToAccount fin:Acc_UA123456789 ;
    fin:belongsToCategory fin:Cat_Rent ;
    fin:hasCounterparty fin:Cp_Orendodavets ;
    fin:operationDate "2026-09-02T00:00:00"^^xsd:dateTime ;
    fin:operationId "00125"^^xsd:string ;
    dcterms:date "2026-09-02T00:00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom "Src_BankExport2026" .

fin:Op_00126 a fin:Expense ;
