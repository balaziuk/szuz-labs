@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fin: <http://example.org/financial-operations#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fin:Acc_Savings_UA987654321 a fin:SavingsAccount ;
    fin:accountNumber "UA987654321"^^xsd:string ;
    fin:balance 5000.0 ;
    fin:currency "UAH"^^xsd:string .

fin:Report_CF_Oct2026 a fin:CashFlowReport ;
    fin:aggregates fin:Op_00128,
        fin:Op_00129,
        fin:Op_00130,
        fin:Op_00131 ;
    fin:period "жовтень 2026"^^xsd:string ;
    fin:totalExpenses 22300.0 ;
    fin:totalIncome 12000.0 .

fin:Report_CF_Sep2026 a fin:CashFlowReport ;
    fin:aggregates fin:Op_00124,
        fin:Op_00125,
        fin:Op_00126,
        fin:Op_00127 ;
    fin:period "вересень 2026"^^xsd:string ;
    fin:totalExpenses 21000.0 ;
    fin:totalIncome 30000.0 .

fin:Risk_LiquidityOct a fin:LiquidityRisk ;
    fin:affectsBudget fin:Budget_Oct2026 ;
    fin:riskDescription "значні витрати на оренду при коливанні доходів"^^xsd:string ;
    fin:riskLevel "середній"^^xsd:string .

fin:Risk_RentConcentration a fin:ExpenseConcentrationRisk ;
    fin:affectsBudget fin:Budget_Sep2026 ;
    fin:relatedToCategory fin:Cat_Rent ;
    fin:riskDescription "частка оренди понад 70% усіх витрат"^^xsd:string ;
    fin:riskLevel "високий"^^xsd:string .

fin:Budget_Oct2026 a fin:Budget ;
    fin:actualAmount 22300.0 ;
    fin:deviation -2700.0 ;
    fin:includesCategory fin:Cat_Food,
        fin:Cat_Rent,
        fin:Cat_Utilities ;
    fin:period "жовтень 2026"^^xsd:string ;
    fin:plannedAmount 25000.0 .

fin:Budget_Sep2026 a fin:Budget ;
    fin:actualAmount 21000.0 ;
    fin:deviation 1000.0 ;
    fin:includesCategory fin:Cat_Food,
        fin:Cat_Rent,
        fin:Cat_Transport ;
    fin:period "вересень 2026"^^xsd:string ;
    fin:plannedAmount 20000.0 .

fin:Cat_Freelance a fin:IncomeCategory ;
    fin:categoryName "Фриланс"^^xsd:string ;
    skos:prefLabel "Фриланс"@uk .

fin:Cat_Salary a fin:IncomeCategory ;
    fin:categoryName "Заробітна плата"^^xsd:string ;
    skos:prefLabel "Заробітна плата"@uk .

fin:Cp_Employer a fin:Client ;
    fin:counterpartyName "ТОВ «Роботодавець»"^^xsd:string ;
    fin:edrpouCode "87654321"^^xsd:string ;
    foaf:name "ТОВ «Роботодавець»"@uk .

fin:Cp_FreelanceClient a fin:Client ;
    fin:counterpartyName "ФОП Іваненко"^^xsd:string ;
    fin:edrpouCode "99887766"^^xsd:string ;
    foaf:name "ФОП Іваненко"@uk .

fin:Cp_Utility a fin:Supplier ;
    fin:counterpartyName "АТ «Київські комунальні»"^^xsd:string ;
    fin:edrpouCode "33445566"^^xsd:string ;
    foaf:name "АТ «Київські комунальні»"@uk .

fin:Op_00124 a fin:Income ;
    fin:amount 30000.0 ;
    fin:belongsToAccount fin:Acc_UA123456789 ;
    fin:belongsToCategory fin:Cat_Salary ;
    fin:hasCounterparty fin:Cp_Employer ;
    fin:operationDate "2026-09-01T00:00:00"^^xsd:dateTime ;
    fin:operationId "00124"^^xsd:string ;
    dcterms:date "2026-09-01T00:00:00"^^xsd:dateTime ;
    prov:wasDerivedFrom "Src_BankExport2026" .

